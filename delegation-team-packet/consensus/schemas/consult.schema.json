{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "consult answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "assessment", "risks", "recommendations", "questions_for_owner", "summary"],
  "properties": {
    "phase": { "type": "string", "enum": ["consult"] },
    "assessment": { "type": "string" },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "severity", "where"],
        "properties": {
          "risk": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "where": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "what", "why"],
        "properties": {
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "questions_for_owner": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  }
}
